# CenterAI — environment template
# =============================================================================
# DEMO MODE IS THE DEFAULT AND NEEDS NO SECRETS AT ALL.
# Copy to `.env`, leave everything blank, and the app runs in Demo Mode:
#   • voice console  → DemoVoiceProvider (scripted, no audio, no network)
#   • database       → in-memory repository (nothing persisted)
#   • storage / CRM  → not initialised
#   • auth           → process-lifetime dev secret only; no tokens issued
#
# PRODUCTION MODE requires the variables in section 3. Boot fails with a clear
# list of missing names if anything is absent.
#
# HARD RULES
#   • Never put a secret in client code. Anything prefixed VITE_ ships to the browser.
#   • Never commit a real .env. Values below are placeholders only.
#   • The logger redacts *key / secret / token / password / authorization / database_url /
#     jwt / storage* — but presence flags are all any endpoint ever returns.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) APPLICATION MODE            [demo: optional · production: required = demo]
# -----------------------------------------------------------------------------
# "demo" (default when unset) | "production"
APP_MODE=demo
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
APP_URL=http://localhost:5173
API_VERSION=0.1.0

# Set to 1 to let a production instance boot in a degraded state (health returns
# "degraded" and protected routes answer 503 CONFIG_INVALID). Use for diagnosis only.
CENTERAI_API_ALLOW_DEGRADED=

# -----------------------------------------------------------------------------
# 2) DEMO MODE — everything below is OPTIONAL (leave blank)
#    Each one is disabled, not faked, when absent.
# -----------------------------------------------------------------------------
# Voice transport. Absent → DemoVoiceProvider stays active; no production provider is
# ever initialised without a valid credential.
VOICE_PROVIDER_NAME=
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_BASE_URL=
VOICE_PROVIDER_WEBHOOK_SECRET=
WEBHOOK_URL=

# ── REAL AI VOICE (browser WebRTC session, brokered by the server) ──
# Demo Mode: leave blank. The console keeps using DemoVoiceProvider and never prompts
# for a microphone. No key, no outbound call, nothing to leak.
# Real voice: set the key (server process only) and enable realtime.
#   · the key is read ONLY in this file's consumer (server/config/env.ts)
#   · the browser receives a short-lived ephemeral session credential minted by the server
#   · never put this key in a VITE_* variable, in React, in HTML, or in localStorage
OPENAI_API_KEY=
# Optional provider scoping (server-side only, also secret-ish):
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com
# auto = real voice whenever a key exists in production · true = try it in demo too · false off
REALTIME_ENABLED=auto
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# Demo sessions are capped well below the provider's 60 minute limit.
REALTIME_MAX_SECONDS=300
# Override only if your egress path differs (e.g. a corporate proxy or gateway).
REALTIME_SDP_URL=https://api.openai.com/v1/realtime/calls

# ── VOICE EXECUTION ENGINE (conversation layer only — no telephony) ──
# auto = OpenAI when a server key exists, otherwise the local demo conversation engine
# demo   = always the demo engine (never calls out)
# openai = require OpenAI; the API answers PROVIDER_NOT_CONFIGURED if the key is missing
VOICE_ENGINE=auto
# Used only when VOICE_ENGINE resolves to openai. Server-side; the browser talks to CenterAI only.
OPENAI_MODEL=gpt-4o-mini
VOICE_TEMPERATURE=0.3
VOICE_HISTORY_TURNS=8
VOICE_TIMEOUT_MS=20000
VOICE_MAX_CONCURRENT=20
# Incremental (SSE) turn streaming is served by the Node/serverless adapters, which can flush
# frames. The in-browser local transport cannot, so it automatically uses buffered turns.
# Nothing to set here — the client reads the capability from /api/voice/engine/capabilities.

# Model providers (text pipelines). Absent → neither is called; scripted answers only.
ANTHROPIC_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Database. Absent → in-memory store appropriate to the existing Db architecture.
# No external/production database is required for Demo Mode.
DATABASE_URL=

# Auth. Absent in demo → an ephemeral, process-lifetime secret is generated in memory.
# It is never read from the browser, never logged, never returned by any endpoint,
# and no tokens are issued. REQUIRED in production.
JWT_SECRET=

# Object storage. Absent → nothing is uploaded anywhere (transcripts stay in memory).
STORAGE_DRIVER=none
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
RETENTION_DAYS=30

# CRM. Absent → the CRM client is never constructed. Not implemented in this phase even
# when a key is present (the registry reports "configured, adapter pending").
CRM_API_KEY=
CRM_BASE_URL=

# -----------------------------------------------------------------------------
# 3) PRODUCTION MODE — REQUIRED (boot fails with these names if missing)
#      APP_MODE=production
#      JWT_SECRET
#      DATABASE_URL
#      VOICE_PROVIDER_API_KEY
#      OPENAI_API_KEY          (real browser voice; also satisfies VOICE_PROVIDER_API_KEY)
#      CORS_ORIGINS
#    Conditionally required:
#      REALTIME_ENABLED=true   → OPENAI_API_KEY must exist (boot is refused otherwise)
#      STORAGE_DRIVER != none → STORAGE_BUCKET_NAME + STORAGE_ACCESS_KEY + STORAGE_SECRET_KEY
#      WEBHOOK_URL set        → VOICE_PROVIDER_WEBHOOK_SECRET
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_BODY_BYTES=32768

# -----------------------------------------------------------------------------
# 4) DECLARED FOR LATER PHASES — DO NOT SET YET (nothing here is implemented)
#    No PSTN, SIP, SIM routing, live calling or call recording exists in this build.
# -----------------------------------------------------------------------------
TELEPHONY_GATEWAY_URL=
SIP_TRUNK_URL=
SIP_TRUNK_USER=
SIP_TRUNK_PASS=
SIM_GATEWAY_URL=
SIM_GATEWAY_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# -----------------------------------------------------------------------------
# 5) BROWSER-EXPOSED (safe by construction: URLs and flags — never keys)
#    Unset VITE_API_BASE_URL → the client executes the API route handlers locally,
#    so the site (and the Voice Demo) works with no backend running at all.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=12000
# auto = ask the API which engine it resolved
# demo = force the simulator (no mic prompt) · realtime = force the live WebRTC path
# http = force the scripted API path
# This is a *behaviour* switch only. There is no VITE_ variable that may hold a key.
VITE_VOICE_BACKEND=auto

# -----------------------------------------------------------------------------
# 6) PRODUCTION DATA & IDENTITY  (Agent Studio)
# -----------------------------------------------------------------------------
# Demo Mode: leave all of these blank.
#   • no DATABASE_URL  → in-memory repository. Nothing is persisted; the studio still
#     validates real registration/logins and stores agents for the life of the process.
#   • no JWT_SECRET    → an ephemeral, process-lifetime demo identity is generated in memory.
#     It is never read from the client, never logged, and disappears on restart.
# Production Mode: DATABASE_URL and JWT_SECRET are REQUIRED; the process exits with the
# missing names listed if either is absent (unless CENTERAI_API_ALLOW_DEGRADED=1).
#   DATABASE_URL — a PostgreSQL connection string. Prisma owns the schema:
#       npx prisma generate && npx prisma migrate deploy
#   JWT_SECRET  — sign with: openssl rand -base64 48   (minimum 32 characters)
DATABASE_URL=
JWT_SECRET=
AUTH_COOKIE_NAME=centerai_session
AUTH_TOKEN_TTL_SECONDS=28800
# Self-service workspace creation. Keep false in production until invitations exist.
ALLOW_REGISTRATION=true

# Cookie hardening (set Secure only behind TLS; the API already forces Secure in production):
# AUTH_COOKIE_SECURE=auto
